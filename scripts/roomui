#!/usr/bin/env python3
"""Start, stop and watch the two local UIs behind sf:orchestrate: agent-team (Build Room) and Podium.

  roomui start    start whichever is down, plus the memory sampler; never restart one that is up
  roomui stop     stop both servers and the sampler, then offer to close each room (y/N, default no)
  roomui rooms    list the rooms (runs) under the state dir, with open questions and last activity
  roomui close <room>... [--force]   archive a room into <state dir>/.closed/<room>-<time>/
  roomui closeout <room> [--base B]  print, as JSON, the sessions to archive and the worktrees to prune
                  before closing it (changes nothing; the /sf:room command archives and prunes)
  roomui status   running or not, pid, RSS, CPU, uptime, URL, and the last 24 hours of samples

Environment: ROOMUI_AGENT_TEAM_DIR (default ~/FyxerGh/agent-team), ROOMUI_PODIUM_DIR (default
~/FyxerGh/podium), ROOMUI_STATE_DIR (pid files and logs, default ~/FyxerGh/build-room).

A process is only ever signalled after its command line says it is one of the two servers (or the
sampler). Podium is stopped through `podiumctl stop`. Nothing here reads Podium's token or config.env,
and podiumctl's own output is not printed on success, because its first start can show the token.
"""
import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

HOME = os.path.expanduser("~")
STATE = os.environ.get("ROOMUI_STATE_DIR") or os.path.join(HOME, "FyxerGh", "build-room")
AGENT_TEAM = os.path.realpath(os.environ.get("ROOMUI_AGENT_TEAM_DIR") or os.path.join(HOME, "FyxerGh", "agent-team"))
PODIUM = os.path.realpath(os.environ.get("ROOMUI_PODIUM_DIR") or os.path.join(HOME, "FyxerGh", "podium"))
SERVERS = {
    "agent-team": {"port": 7777, "url": "http://127.0.0.1:7777/room", "env": "ROOMUI_AGENT_TEAM_DIR"},
    "podium": {"port": 4317, "url": "http://127.0.0.1:4317/#/", "env": "ROOMUI_PODIUM_DIR"},
}
PIDFILE = {"agent-team": "agent-team.pid", "sampler": "roomui-sampler.pid"}
LOG = {"agent-team": "agent-team.log", "samples": "roomui-samples.log"}
SAMPLE_EVERY = 60
MAX_SAMPLES = 20160  # a week of two servers a minute; the oldest lines go first
TS = "%Y-%m-%dT%H:%M:%SZ"


def sh(args, timeout=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def path(kind, name):
    return os.path.join(STATE, (PIDFILE if kind == "pid" else LOG)[name])


def parse_etime(text):
    """ps etime, [[dd-]hh:]mm:ss, to seconds."""
    days, _, rest = text.strip().rpartition("-")
    secs = 0
    for part in rest.split(":"):
        secs = secs * 60 + int(part)
    return secs + int(days or 0) * 86400


def parse_ps(text):
    """One `ps -o pid=,etime=,rss=,pcpu=` line to a dict, or None."""
    for line in text.splitlines():
        f = line.split()
        if len(f) == 4 and f[0].isdigit():
            try:
                return {"pid": int(f[0]), "up": parse_etime(f[1]), "rss": int(f[2]) / 1024, "cpu": float(f[3])}
            except ValueError:
                pass
    return None


def parse_sample(line):
    """`<ISO time> <name> <pid> <rss MB> <cpu %>` to (datetime, name, rss), or None."""
    f = line.split()
    try:
        return datetime.strptime(f[0], TS).replace(tzinfo=timezone.utc), f[1], float(f[3])
    except (ValueError, IndexError):
        return None


def summarise(lines, now, hours=24):
    """{name: (samples, peak MB, average MB)} over the last `hours`."""
    seen = {}
    for line in lines:
        s = parse_sample(line)
        if s and now - timedelta(hours=hours) <= s[0] <= now:
            seen.setdefault(s[1], []).append(s[2])
    return {n: (len(v), max(v), sum(v) / len(v)) for n, v in seen.items()}


def stats(pid):
    return parse_ps(sh(["ps", "-p", str(pid), "-o", "pid=,etime=,rss=,pcpu="]))


def command(pid):
    return sh(["ps", "-p", str(pid), "-o", "command="]).strip()


def cwd(pid):
    for line in sh(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"]).splitlines():
        if line.startswith("n"):
            return os.path.realpath(line[1:])
    return None


def is_server(name, pid):
    cmd = command(pid)
    if name == "agent-team":
        return "server.mjs" in cmd.split() and cwd(pid) == AGENT_TEAM
    return os.path.join(PODIUM, "server", "dist", "index.js") in cmd


def is_sampler(pid):
    cmd = command(pid)
    return "roomui" in cmd and cmd.endswith(" sampler")


def find(name):
    """('up', pid), ('down', None) or ('busy', pids): the port is held by something that is not ours."""
    pids = [int(p) for p in sh(["lsof", "-nP", f"-iTCP:{SERVERS[name]['port']}", "-sTCP:LISTEN", "-t"]).split()]
    if not pids:
        return "down", None
    ours = [p for p in pids if is_server(name, p)]
    return ("up", ours[0]) if ours else ("busy", pids)


def read_pid(name):
    try:
        with open(path("pid", name)) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def sampler_pid():
    pid = read_pid("sampler")
    return pid if pid and stats(pid) and is_sampler(pid) else None


def missing(name):
    d = AGENT_TEAM if name == "agent-team" else PODIUM
    marker = "server.mjs" if name == "agent-team" else os.path.join("bin", "podiumctl")
    if os.path.exists(os.path.join(d, marker)):
        return None
    return f"{name}: not found at {d}; set {SERVERS[name]['env']} to its repo"


def stop_pid(pid, what):
    os.kill(pid, signal.SIGTERM)
    for _ in range(50):
        if not stats(pid):
            return f"stopped {what} (pid {pid})"
        time.sleep(0.1)
    return f"sent SIGTERM to {what} (pid {pid}) but it is still running"


def start_agent_team():
    err = missing("agent-team")
    if err:
        return err
    os.makedirs(STATE, exist_ok=True)
    with open(path("log", "agent-team"), "ab") as log:
        subprocess.Popen(["npm", "start"], cwd=AGENT_TEAM, stdin=subprocess.DEVNULL, stdout=log,
                         stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(100):
        state, pid = find("agent-team")
        if state == "up":
            with open(path("pid", "agent-team"), "w") as f:
                f.write(f"{pid}\n")
            return f"agent-team: started (pid {pid}); log {path('log', 'agent-team')}"
        time.sleep(0.2)
    return f"agent-team: did not come up in 20s; see {path('log', 'agent-team')}"


def podiumctl(*args):
    out = subprocess.run([os.path.join(PODIUM, "bin", "podiumctl"), *args], capture_output=True, text=True,
                         timeout=180)
    return out.returncode, (out.stdout + out.stderr)


def podiumctl_failed(what, code, text):
    tail = [l for l in text.splitlines() if "token" not in l.lower()][-5:]
    return f"podium: `podiumctl {what}` failed ({code})\n  " + "\n  ".join(tail)


def start_podium():
    err = missing("podium")
    if err:
        return err
    code, text = podiumctl("start", "--mode", "standalone")
    state, pid = find("podium")
    if code or state != "up":
        return podiumctl_failed("start", code, text)
    return f"podium: started (pid {pid})"


def start_sampler():
    if sampler_pid():
        return f"sampler: already running (pid {sampler_pid()})"
    os.makedirs(STATE, exist_ok=True)
    p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "sampler"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    with open(path("pid", "sampler"), "w") as f:
        f.write(f"{p.pid}\n")
    return f"sampler: started (pid {p.pid}); log {path('log', 'samples')}"


def cmd_start():
    out = []
    for name, starter in (("agent-team", start_agent_team), ("podium", start_podium)):
        state, pid = find(name)
        if state == "up":
            out.append(f"{name}: already running (pid {pid})")
        elif state == "busy":
            out.append(f"{name}: port {SERVERS[name]['port']} is held by another process (pid "
                       f"{', '.join(map(str, pid))}); not starting, not touching it")
        else:
            out.append(starter())
    out.append(start_sampler())
    out += ["", f"Build Room  {SERVERS['agent-team']['url']}", f"Podium      {SERVERS['podium']['url']}"]
    print("\n".join(out))
    return 0


def cmd_stop(ask=True):
    out = []
    pid = sampler_pid()
    out.append(stop_pid(pid, "sampler") if pid else "sampler: not running")
    state, pid = find("agent-team")
    if state == "up":
        out.append(stop_pid(pid, "agent-team"))
    elif state == "busy":
        out.append(f"agent-team: port 7777 is held by another process (pid {', '.join(map(str, pid))}); left alone")
    else:
        out.append("agent-team: not running")
    for name in ("agent-team", "sampler"):
        if not (stats(read_pid(name) or 0)):
            try:
                os.remove(path("pid", name))
            except OSError:
                pass
    state, pid = find("podium")
    if state == "busy":
        out.append(f"podium: port 4317 is held by another process (pid {', '.join(map(str, pid))}); left alone")
    elif state == "down":
        out.append("podium: not running")
    elif missing("podium"):
        out.append(missing("podium"))
    else:
        code, text = podiumctl("stop")
        out.append(f"stopped podium (pid {pid})" if not code and find("podium")[0] == "down"
                   else podiumctl_failed("stop", code, text))
    print("\n".join(out))
    offer_close(ask)
    return 0


RECENT = 600  # a room with an event in the last 10 minutes is treated as live


def room_names():
    if not os.path.isdir(STATE):
        return []
    return sorted(
        d for d in os.listdir(STATE)
        if not d.startswith(".") and os.path.isdir(os.path.join(STATE, d))
        and any(os.path.exists(os.path.join(STATE, d, f)) for f in ("tickets.json", "events.jsonl"))
    )


def room_summary(slug):
    """What a person needs to decide whether to close a room: who runs it, its size, and whether it is live."""
    d = os.path.join(STATE, slug)
    try:
        with open(os.path.join(d, "tickets.json"), encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        doc = {}
    events = []
    try:
        with open(os.path.join(d, "events.jsonl"), encoding="utf-8") as f:
            for line in f:
                try:
                    events.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    answered = {int(m.group(1)) for e in events if e.get("type") == "answer"
                for m in [re.match(r"re (\d+):", str(e.get("note", "")))] if m}
    open_q = sum(1 for e in events if e.get("type") == "question" and e.get("ask") and e.get("id") not in answered)
    last = None
    for e in events:
        try:
            t = datetime.strptime(e["ts"], TS).replace(tzinfo=timezone.utc)
        except (KeyError, ValueError, TypeError):
            continue
        last = t if last is None or t > last else last
    tickets = doc.get("tickets") if isinstance(doc.get("tickets"), list) else []
    return {"slug": slug, "orchestrator": str(doc.get("orchestrator") or ""), "tickets": len(tickets),
            "open": open_q, "last": last}


def room_line(r, now):
    bits = [f"{r['tickets']} tickets"]
    if r["orchestrator"]:
        bits.append(f"orchestrator {r['orchestrator']}")
    bits.append(f"{r['open']} open question{'' if r['open'] == 1 else 's'}")
    bits.append(f"last event {duration(int((now - r['last']).total_seconds()))} ago" if r["last"] else "no events")
    return f"{r['slug']}  " + " · ".join(bits)


def close_room(slug, force=False, now=None):
    """Archive a room instead of deleting it. Returns (done, message)."""
    now = now or datetime.now(timezone.utc)
    if not slug or slug.startswith(".") or os.sep in slug or slug not in room_names():
        return False, f"{slug}: no such room under {STATE}"
    r = room_summary(slug)
    live = r["last"] is not None and (now - r["last"]).total_seconds() < RECENT
    if not force and (r["open"] or live):
        why = " and ".join(x for x in (f"{r['open']} open question{'' if r['open'] == 1 else 's'}" if r["open"] else "",
                                       "an event in the last 10 minutes" if live else "") if x)
        return False, f"{slug}: not closed, it has {why}. Add --force to close it anyway."
    root = os.path.join(STATE, ".closed")
    os.makedirs(root, exist_ok=True)
    dest = os.path.join(root, f"{slug}-{now.strftime('%Y%m%dT%H%M%SZ')}")
    os.rename(os.path.join(STATE, slug), dest)
    return True, f"closed {slug}: moved to {dest} (delete for good with: rm -r {dest})"


TASKS = ("explore", "investigate", "plan", "design", "prototype", "size", "evaluate", "measure")  # room's TASKS
FINISHED = ("DONE", "MERGED")  # any other state is an open ticket


def git(wt, *args, timeout=30):
    try:
        return subprocess.run(["git", "-C", wt, *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 1, "", str(e))


def branches_in_use():
    """{branch: "<room>/<ticket>"} for every open ticket in every room."""
    out = {}
    for slug in room_names():
        try:
            with open(os.path.join(STATE, slug, "tickets.json"), encoding="utf-8") as f:
                tickets = json.load(f).get("tickets") or []
        except (OSError, ValueError, AttributeError):
            continue
        for t in tickets:
            if isinstance(t, dict) and t.get("branch") and t.get("state") not in FINISHED:
                out.setdefault(t["branch"], f"{slug}/{t.get('id')}")
    return out


def worktree_verdict(wt, base, in_use):
    """(prune?, why) for one worktree: merged into the remote base, named by no open ticket, nothing uncommitted."""
    if not os.path.isdir(wt):
        return False, "worktree is gone already"
    branch = git(wt, "symbolic-ref", "--short", "HEAD").stdout.strip()
    if git(wt, "status", "--porcelain").stdout.strip():
        return False, "has uncommitted changes"
    if branch in in_use:
        return False, f"branch {branch} is named by open ticket {in_use[branch]}"
    if git(wt, "fetch", "origin", base).returncode:
        return False, f"could not fetch origin/{base}, so merged is unknown"
    merged = git(wt, "merge-base", "--is-ancestor", "HEAD", f"origin/{base}").returncode == 0
    squashed = not git(wt, "diff", f"origin/{base}...HEAD").stdout.strip()  # a squash merge leaves no diff
    if not (merged or squashed):
        return False, f"branch {branch or '(detached)'} is not merged into origin/{base}"
    return True, f"branch {branch or '(detached)'} is merged into origin/{base}, clean, and no open ticket names it"


def closeout(slug, base="staging"):
    """What closing a room archives and prunes. A task's or build's session is archived (never deleted) only once
    the ticket is finished (DONE or MERGED); its worktree is pruned only when worktree_verdict says so. Tickets
    adopted from another run are left to that run. Nothing here changes anything."""
    if not slug or slug.startswith(".") or os.sep in slug or slug not in room_names():
        return None
    try:
        with open(os.path.join(STATE, slug, "tickets.json"), encoding="utf-8") as f:
            tickets = [t for t in json.load(f).get("tickets") or [] if isinstance(t, dict)]
    except (OSError, ValueError, AttributeError):
        tickets = []
    own = [t for t in tickets if not t.get("source")]
    in_use = branches_in_use()
    plan = {"room": slug, "base": base, "archive": [], "keepSessions": [], "prune": [], "keepWorktrees": []}
    for t in own:
        who = {"ticket": t.get("id"), "session": t.get("session"), "sessionId": t.get("sessionId")}
        if not t.get("session"):
            continue
        if t.get("state") not in FINISHED:
            what = "task" if t.get("kind") in TASKS else "build"
            plan["keepSessions"].append({**who, "why": f"{what} is {t.get('state')}, not finished"})
            continue
        plan["archive"].append(who)
        if t.get("worktree"):
            ok, why = worktree_verdict(os.path.expanduser(t["worktree"]), base, in_use)
            plan["prune" if ok else "keepWorktrees"].append(
                {"ticket": t.get("id"), "worktree": t["worktree"], "branch": t.get("branch"), "why": why})
    return plan


def cmd_closeout(names, base):
    if len(names) != 1:
        print("closeout needs one room name; `roomui rooms` lists them")
        return 2
    plan = closeout(names[0], base)
    if plan is None:
        print(f"{names[0]}: no such room under {STATE}")
        return 1
    print(json.dumps(plan, indent=2))
    return 0


def cmd_rooms():
    names = room_names()
    now = datetime.now(timezone.utc)
    print("\n".join(room_line(room_summary(n), now) for n in names) if names else f"no rooms under {STATE}")
    return 0


def cmd_close(names, force):
    if not names:
        print("close needs a room name; `roomui rooms` lists them")
        return 2
    results = [close_room(n, force) for n in names]
    print("\n".join(m for _, m in results))
    return 0 if all(ok for ok, _ in results) else 1


def offer_close(ask):
    names = room_names()
    if not names:
        return
    now = datetime.now(timezone.utc)
    rooms = [room_summary(n) for n in names]
    print("\nRooms:\n" + "\n".join("  " + room_line(r, now) for r in rooms))
    if not (ask and sys.stdin.isatty()):
        print("Close one with: roomui close <room> (add --force if it has open questions or recent events)")
        return
    for r in rooms:
        try:
            answer = input(f"Close room {r['slug']}? [y/N] ")
        except EOFError:
            return
        if answer.strip().lower() in ("y", "yes"):
            print(close_room(r["slug"], force=True)[1])


def duration(secs):
    d, r = divmod(secs, 86400)
    h, r = divmod(r, 3600)
    m, s = divmod(r, 60)
    return f"{d}d {h}h {m}m" if d else f"{h}h {m:02d}m" if h else f"{m}m {s:02d}s"


def read_samples():
    try:
        with open(path("log", "samples")) as f:
            return f.read().splitlines()
    except OSError:
        return []


def cmd_status():
    hist = summarise(read_samples(), datetime.now(timezone.utc))
    out = []
    for name, spec in SERVERS.items():
        state, pid = find(name)
        s = stats(pid) if state == "up" else None
        if s:
            out.append(f"{name:<11} running  pid {pid}  {s['rss']:.1f} MB  cpu {s['cpu']:.1f}%  up {duration(s['up'])}")
        elif state == "busy":
            out.append(f"{name:<11} port {spec['port']} held by another process (pid {', '.join(map(str, pid))})")
        else:
            out.append(f"{name:<11} not running" + (f"  ({missing(name)})" if missing(name) else ""))
        out.append(f"{'':<11} {spec['url']}")
        n, peak, avg = hist.get(name, (0, 0, 0))
        out.append(f"{'':<11} last 24h: peak {peak:.1f} MB, avg {avg:.1f} MB ({n} samples)" if n
                   else f"{'':<11} last 24h: no history yet")
    pid = sampler_pid()
    out.append(f"{'sampler':<11} " + (f"running  pid {pid}" if pid else "not running (roomui start begins it)"))
    print("\n".join(out))
    return 0


def sample_once():
    now = datetime.now(timezone.utc).strftime(TS)
    lines = []
    for name in SERVERS:
        state, pid = find(name)
        s = stats(pid) if state == "up" else None
        if s:
            lines.append(f"{now} {name} {pid} {s['rss']:.1f} {s['cpu']:.1f}\n")
    if lines:
        with open(path("log", "samples"), "a") as f:
            f.write("".join(lines))
        kept = read_samples()
        if len(kept) > MAX_SAMPLES:
            tmp = path("log", "samples") + ".tmp"
            with open(tmp, "w") as f:
                f.write("\n".join(kept[-MAX_SAMPLES:]) + "\n")
            os.replace(tmp, path("log", "samples"))


def cmd_sampler():
    while True:
        sample_once()
        time.sleep(SAMPLE_EVERY - time.time() % SAMPLE_EVERY)


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("action", choices=("start", "stop", "status", "rooms", "close", "closeout", "sampler"), nargs="?",
                    default="status")
    ap.add_argument("names", nargs="*", help="rooms to close")
    ap.add_argument("--base", default="staging", help="closeout: the remote base a worktree's branch must be merged into")
    ap.add_argument("--force", action="store_true", help="close a room even with open questions or recent events")
    ap.add_argument("--no-ask", action="store_true", help="stop without offering to close rooms")
    a = ap.parse_args()
    run = {"start": cmd_start, "stop": lambda: cmd_stop(not a.no_ask), "status": cmd_status, "rooms": cmd_rooms,
           "close": lambda: cmd_close(a.names, a.force), "closeout": lambda: cmd_closeout(a.names, a.base),
           "sampler": cmd_sampler}
    sys.exit(run[a.action]())
